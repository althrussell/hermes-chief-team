# Hermes profile "${HCT_HERMES_PROFILE}" (Chief). Generated by hermes-chief-team install.sh.
# Every model call goes through Databricks Unity Gateway at ${HCT_WORKSPACE_HOST}.
_config_version: 51
model:
  provider: custom:unity-chief
  default: ${HCT_MODEL_CHIEF}
  context_length: ${HCT_CHIEF_CONTEXT_LENGTH}
providers:
  unity-chief:
    name: Unity Gateway (Chief)
    api: ${HCT_WORKSPACE_HOST}/ai-gateway/openai/v1
    transport: codex_responses
    key_cmd: ${HCT_DATABRICKS_BIN} auth token --profile ${HCT_DATABRICKS_PROFILE} -o json
    discover_models: false
    context_length: ${HCT_CHIEF_CONTEXT_LENGTH}
    extra_headers:
      Databricks-Ai-Gateway-Request-Tags: '{"source":"hermes-chief-team","harness":"hermes","role":"chief"}'
    models:
      ${HCT_MODEL_CHIEF}:
        context_length: ${HCT_CHIEF_CONTEXT_LENGTH}
# No silent direct-provider fallback anywhere.
fallback_providers: []
delegation:
  fallback_providers: []
terminal:
  cwd: ${HCT_CHIEF_DIR}
# Background/helper inference (titles, compression, review, curator, ...) uses the same route.
auxiliary:
${HCT_AUX_BLOCK}agent:
  # Toolsets whose backends are non-Databricks AI services (not routed through Unity Gateway).
  disabled_toolsets: [tts, image_gen, video_gen, video, x_search, computer_use]
stt:
  enabled: false
model_catalog:
  enabled: false
updates:
  check: false
display:
  skin: chief
