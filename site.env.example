# Copy to site.env (git-ignored) and fill in. install.sh renders every template from these values.
# Leave a *_BIN value empty to auto-detect it from PATH (resolved to a stable real path).

# Databricks workspace that serves Unity Gateway, and the Databricks CLI profile used to mint tokens.
HCT_WORKSPACE_HOST=https://<workspace>.cloud.databricks.com
HCT_DATABRICKS_PROFILE=<databricks-cli-profile>

# Exact Unity Catalog model-service names (check: databricks ai-gateway list-model-services --parent schemas/system.ai)
HCT_MODEL_CHIEF=system.ai.gpt-5-5
HCT_MODEL_PLANNER=system.ai.claude-opus-5-5
HCT_MODEL_REVIEWER=system.ai.claude-opus-5-5
HCT_MODEL_CLAUDE=system.ai.claude-opus-5-5
HCT_MODEL_CODER=system.ai.gemini-4-argon
HCT_MODEL_TESTER=system.ai.gpt-6-1-sol
# Context window Hermes uses for Chief's compression decisions (conservative pin).
HCT_CHIEF_CONTEXT_LENGTH=272000

# Hermes profile and Chief's durable scratch directory (not a git repo).
HCT_HERMES_PROFILE=chief
HCT_CHIEF_DIR=$HOME/Hermes/Chief
HCT_WORKTREES_DIR=$HOME/Hermes/Worktrees

# Product repositories (keys used by `teamctl workspace prepare --repo <key>`).
HCT_PROJECT_WT_ROOT=$HOME/code/<workshop-terminal-repo>
HCT_PROJECT_WT_BASE=origin/main
HCT_PROJECT_CT_ROOT=$HOME/code/<control-tower-repo>
HCT_PROJECT_CT_BASE=origin/main

# Executables (empty = auto-detect).
HCT_DATABRICKS_BIN=
HCT_CLAUDE_BIN=
HCT_CODEX_BIN=
HCT_OPENCODE_BIN=
HCT_NODE_BIN_DIR=
HCT_PYTHON=
